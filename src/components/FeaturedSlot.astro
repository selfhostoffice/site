---
const { where = 'this category', href = '/claim/', title = 'Your tool here' } = Astro.props;
---
<aside class="featured-slot" aria-label="Featured placement">
  <span class="feat-tag">Featured</span>
  <div><b>{title}</b><p class="muted small">Make an open-source business tool? You can pay for this labeled spot in {where}. It doesn’t change anyone’s numbers or order.</p></div>
  <a class="btn" href={href} data-track="claim_cta">How it works</a>
</aside>
