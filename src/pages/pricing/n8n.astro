};
const cloud = [
  { plan: 'Starter', price: '€20/mo', usd: '≈ $22/mo', note: 'billed annually; 5 concurrent executions, 2.5k saved executions, 1 shared project, forum support' },
  { plan: 'Pro', price: '€50/mo', usd: '≈ $56/mo', note: 'billed annually; up to 50 concurrent executions, 25k saved executions, 3 shared projects, admin roles' },
  { plan: 'Business', price: '€667/mo', usd: '≈ $749/mo', note: 'billed annually; self-hosted only (license key); SSO/LDAP, environments, Git version control, queue mode' },
  { plan: 'Enterprise', price: 'Contact sales', note: 'cloud or self-hosted; SLA support, log streaming, external secrets' },
  { plan: 'Community edition', price: '€0 license', usd: '$0', note: 'self-hosted; you pay for the server and your time' },
];
const vps = [
  { host: 'Hetzner', plan: 'CX23 (Cost-Optimized)', spec: '2 vCPU · 4 GB · 40 GB NVMe', price: '€5.99/mo excl. VAT', usd: 'from ≈ $6.73/mo', src: S.hzCost, note: 'listed as "not available" when checked' },
  { host: 'Hetzner', plan: 'CPX22 (Regular Performance)', spec: '2 vCPU · 4 GB · 80 GB NVMe', price: '€19.99/mo excl. VAT', usd: 'from ≈ $22/mo', src: S.hzReg, note: '' },
  { host: 'Hetzner', plan: 'CPX11 (US locations)', spec: '2 vCPU · 2 GB · 40 GB NVMe', price: '€17.99/mo excl. VAT', usd: '≈ $20/mo', src: S.hzReg, note: 'the type n8n’s Hetzner guide names' },
  { host: 'DigitalOcean', plan: 'Basic Droplet', spec: '1 vCPU · 2 GiB · 50 GiB SSD', price: '$12.00/mo', src: S.do, note: '' },
  { host: 'DigitalOcean', plan: 'Basic Droplet', spec: '2 vCPU · 4 GiB · 80 GiB SSD', price: '$24.00/mo', src: S.do, note: 'meets the 4 GB / 2 vCPU guidance for Assistant' },
  { host: 'Vultr', plan: 'Cloud Compute, Regular', spec: '1 vCPU · 2 GB · 55 GB SSD', price: '$10.00/mo', src: S.vultr, note: '' },
  { host: 'Vultr', plan: 'Cloud Compute, Regular', spec: '2 vCPU · 4 GB · 80 GB SSD', price: '$20.00/mo', src: S.vultr, note: '' },
