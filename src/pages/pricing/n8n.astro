const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'n8n pricing: Cloud vs self-hosted, real monthly cost', dateModified: '2026-10-21', author: { '@type': 'Organization', name: 'SelfHost Office' }, mainEntityOfPage: new URL('/pricing/n8n/', Astro.site).toString() },
