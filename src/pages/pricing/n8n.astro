const faq = [
  { q: 'How much does n8n cost per month?', a: 'On n8n Cloud, Starter is about $22/mo (€20) and Pro about $56/mo (€50), both billed annually (n8n.io/pricing, checked Oct 21, 2026). Self-hosting the Community edition has no license fee; you pay for a server, which starts around $10–24/mo on DigitalOcean or Vultr for a 2–4 GB machine.' },
