---
import Base from '../../layouts/Base.astro';
import OnSelfHost from '../../components/OnSelfHost.astro';
import { listings } from '../../lib/data';
const sb = listings.find(l => l.slug === 'supabase--supabase')!;
const aw = listings.find(l => l.slug === 'appwrite--appwrite');
const pb = listings.find(l => l.slug === 'pocketbase--pocketbase');
const nh = listings.find(l => l.slug === 'nhost--nhost');
const CHECKED = 'Nov 15, 2026';
const FIRST = 'Oct 25, 2026';
const FX = 1.1052; // ECB euro reference rate, Nov 13, 2026 (latest published before this check)
const usd = (eur: number) => Math.round(eur * FX * 100) / 100;
const m = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 });
const S = {
  pricing: 'https://supabase.com/pricing',
  docker: 'https://supabase.com/docs/guides/self-hosting/docker',
  self: 'https://supabase.com/docs/guides/self-hosting',
  compose: 'https://github.com/supabase/supabase/blob/self-hosted/v0.8.4/docker/docker-compose.yml',
  hub: 'https://hub.docker.com/u/supabase',
  do: 'https://www.digitalocean.com/pricing/droplets',
  hz: 'https://www.hetzner.com/cloud/cost-optimized',
  ecb: 'https://data.ecb.europa.eu/data/datasets/EXR/EXR.D.USD.EUR.SP00.A',
  aw: 'https://appwrite.io/pricing',
  awSelf: 'https://appwrite.io/docs/advanced/self-hosting/installation',
  nh: 'https://nhost.io/pricing',
  nhSelf: 'https://docs.nhost.io/platform/self-hosting',
  fb: 'https://firebase.google.com/pricing',
  pb: 'https://pocketbase.io/',
};
const plans = [
  { plan: 'Free', price: '$0', note: '2 active projects, 500 MB database, shared CPU with 500 MB RAM, 1 GB file storage, 5 GB egress (plus 5 GB cached), 50,000 monthly active users, community support. Projects pause after 1 week with no activity.' },
  { plan: 'Pro', price: 'from $25/mo', note: '$10 of compute credit (one Micro instance), 8 GB disk per project, 100 GB file storage, 250 GB egress (plus 250 GB cached), 100,000 MAU, daily backups kept 7 days, 7-day logs, email support, no pausing. Spend cap on by default.' },
  { plan: 'Team', price: 'from $599/mo', note: 'Pro allowances plus SOC 2 and ISO 27001 reports, SSO for the dashboard, read-only and project-scoped roles, HIPAA as a paid add-on, 14-day backups, 28-day logs, support SLAs.' },
  { plan: 'Enterprise', price: 'Custom', note: 'Uptime SLAs, AWS PrivateLink, 24/7 support, private Slack channel, account manager.' },
];
const compute = [
  ['Micro', 10, 'Shared', '1 GB', 60], ['Small', 15, 'Shared', '2 GB', 90], ['Medium', 60, 'Shared', '4 GB', 120],
  ['Large', 110, '2 dedicated vCPU', '8 GB', 160], ['XL', 210, '4 dedicated vCPU', '16 GB', 240], ['2XL', 410, '8 dedicated vCPU', '32 GB', 380],
] as const;
const over = [
  ['Monthly active users', '100,000', '$0.00325 per user'],
  ['Database disk', '8 GB per project', '$0.125 per GB'],
  ['Egress (uncached)', '250 GB', '$0.09 per GB'],
  ['Cached egress (CDN)', '250 GB', '$0.03 per GB'],
  ['File storage', '100 GB', '$0.0213 per GB'],
  ['Edge Function calls', '2 million', '$2 per million'],
  ['Realtime messages', '5 million', '$2.50 per million'],
  ['Realtime peak connections', '500', '$10 per 1,000'],
  ['Image transformations', '100 origin images', '$5 per 1,000'],
  ['Point-in-time recovery', 'not included', '$100/mo per 7 days kept'],
  ['Branching', 'not included', '$0.01344 per branch-hour (about $9.81 if one runs all month)'],
  ['Phone MFA', 'not included', '$75/mo first project, $10 each after'],
  ['Custom domain', 'not included', '$10/mo per project'],
  ['Log drain', 'not included', '$60/mo per drain + $0.20 per million events'],
] as const;
// Worked examples. Pro $25 + compute - $10 credit, then overages from the table above.
const r2 = (n: number) => Math.round(n * 100) / 100;
const ex = [
  { name: 'Production + staging, small', what: 'Two Micro projects, under every allowance', lines: [['Pro plan', 25], ['2 × Micro compute', 20], ['Compute credit', -10]] },
  { name: 'Growing app', what: 'Small compute, 150,000 MAU, 20 GB database, 500 GB egress, 150 GB files, custom domain', lines: [['Pro plan', 25], ['Small compute', 15], ['Compute credit', -10], ['50,000 extra MAU', r2(50000 * 0.00325)], ['12 GB extra disk', r2(12 * 0.125)], ['250 GB extra egress', r2(250 * 0.09)], ['50 GB extra files', r2(50 * 0.0213)], ['Custom domain', 10]] },
  { name: 'Busy app', what: 'Medium compute, 300,000 MAU, 50 GB database, 2 TB egress, 100 GB files, 7-day PITR', lines: [['Pro plan', 25], ['Medium compute', 60], ['Compute credit', -10], ['200,000 extra MAU', r2(200000 * 0.00325)], ['42 GB extra disk', r2(42 * 0.125)], ['1,750 GB extra egress', r2(1750 * 0.09)], ['PITR, 7 days', 100]] },
].map(e => ({ ...e, total: r2(e.lines.reduce((a, [, v]) => a + (v as number), 0)) }));
const selfRows = [
  { who: 'DigitalOcean 2 vCPU / 4 GiB (Supabase’s minimum)', base: 24, transfer: '4,000 GiB', disk: '80 GiB' },
  { who: 'DigitalOcean 4 vCPU / 8 GiB (recommended)', base: 48, transfer: '5,000 GiB', disk: '160 GiB' },
  { who: 'DigitalOcean 8 vCPU / 16 GiB', base: 96, transfer: '6,000 GiB', disk: '320 GiB' },
  { who: 'Hetzner CX23, 2 vCPU / 4 GB (Germany/Finland)', base: usd(5.99), eur: 5.99, transfer: '20 TB', disk: '40 GB' },
  { who: 'Hetzner CX33, 4 vCPU / 8 GB (Germany/Finland)', base: usd(8.99), eur: 8.99, transfer: '20 TB', disk: '80 GB' },
];
const bars = [
  { label: 'Cloud Pro + Micro (1 GB)', v: 25, kind: 'cloud' },
  { label: 'Cloud Pro + Small (2 GB)', v: 30, kind: 'cloud' },
  { label: 'Cloud Pro + Medium (4 GB)', v: 75, kind: 'cloud' },
  { label: 'Cloud Pro + Large (8 GB)', v: 125, kind: 'cloud' },
  { label: 'Self-hosted, DO 4 GiB + backups', v: 28.8, kind: 'self' },
  { label: 'Self-hosted, DO 8 GiB + backups', v: 57.6, kind: 'self' },
  { label: 'Self-hosted, Hetzner CX33 + backups', v: r2(usd(8.99) * 1.2), kind: 'self' },
];
const maxV = 125;
// Docker Hub API, Nov 15, 2026: compressed linux/amd64 size of each image pinned in the self-hosted/v0.8.4 compose file.
const images = [
  ['Edge Runtime (functions)', 'edge-runtime v1.77.9', 393], ['Postgres 17', 'postgres 17.6.1.136', 367], ['Studio (dashboard)', 'studio 2026.11.02', 356], ['Supavisor (pooler)', 'supavisor 2.9.13', 356],
  ['Storage API', 'storage-api v1.89.12', 257], ['Realtime', 'realtime v2.148.3', 125], ['postgres-meta', 'v0.100.0', 114], ['imgproxy', 'v4.0.21', 89], ['Envoy (API gateway)', 'v1.39.6', 72], ['Auth (GoTrue)', 'gotrue v2.197.0', 30], ['PostgREST', 'v14.18', 6],
] as const;
const totalMB = images.reduce((a, [, , s]) => a + s, 0);
const alts = [
  { who: 'Supabase', href: '/tool/supabase--supabase/', free: '$0: 2 projects, 50K MAU, 500 MB database, pauses after a week idle', paid: 'Pro from $25 (one Micro project); +$0.00325 per user over 100K', self: `Yes, Apache-2.0. 11 containers, 4 GB RAM minimum, 8 GB recommended`, lic: sb },
  { who: 'Appwrite', href: '/tool/appwrite--appwrite/', free: '$0: 2 projects, 75K MAU, 2 GB storage, pauses after a week idle', paid: 'Pro from $25 for 1 project ($15 per extra); 200K MAU, then $3 per 1,000; 2 TB bandwidth', self: 'Yes, BSD-3-Clause. 2 cores, 4 GB RAM and 2 GB swap minimum', lic: aw },
  { who: 'Nhost', href: '/tool/nhost--nhost/', free: '$0: 1 project, 1 GB database, unlimited users, pauses after a week idle', paid: 'Pro from $25 with $15 compute credit; 10 GB database ($0.20/GB after), 50 GB egress ($0.10/GB after)', self: 'Yes, MIT, community support or a paid support agreement. No sizing published on its overview page', lic: nh },
  { who: 'Firebase', href: '/alternatives/firebase/', free: 'Spark: no cost. Firestore 1 GiB, 50K reads and 20K writes a day; Auth 50K MAU', paid: 'Blaze: pay as you go at Google Cloud rates, no plan fee', self: 'No. Closed source, Google Cloud only', lic: undefined },
  { who: 'PocketBase', href: '/tool/pocketbase--pocketbase/', free: 'No hosted plan', paid: 'Only your server: a $6 1 GiB Droplet is enough for a small app', self: 'Yes, MIT. One 12.8 MB download; 39 MB RAM empty, 92 MB with 100,000 records in my test', lic: pb },
];
const faq = [
  { q: 'How much does Supabase cost per month?', a: `On ${CHECKED} supabase.com/pricing listed Free at $0, Pro from $25 a month, Team from $599 a month and custom Enterprise pricing. Pro includes $10 of compute credit, which covers one Micro project, so one small production app is $25. Each extra project adds its own compute (from $10), and usage over the allowances is billed at the end of the month.` },
  { q: 'Is Supabase free?', a: 'The Free plan is: 2 active projects, a 500 MB database, 1 GB of file storage, 5 GB of egress and 50,000 monthly active users. The catch is that free projects pause after a week with no activity, and there are no backups, so I would not run anything customers rely on there. Self-hosting is also free software-wise (Apache-2.0); you pay for the server.' },
  { q: 'What happens when I go over the Pro plan limits?', a: 'With the spend cap on (the default), Supabase limits you to the plan’s quota instead of billing more. Turn the cap off and overages are charged at the end of the month: $0.00325 per extra monthly active user, $0.09 per GB of egress, $0.125 per GB of disk and $0.0213 per GB of file storage. Compute size is never covered by the cap; it is billed hourly for whatever size you pick.' },
  { q: 'How much does it cost to self-host Supabase?', a: `The software costs nothing. Supabase’s Docker guide asks for at least 4 GB RAM, 2 cores and 40 GB SSD, and recommends 8 GB, 4 cores and 80 GB. On ${CHECKED} that was $24 or $48 a month on DigitalOcean ($28.80 or $57.60 with weekly backups), or about ${m(usd(5.99))} and ${m(usd(8.99))} on Hetzner in Europe. Add a mail service for auth emails and your own time for updates and restores.` },
  { q: 'Is self-hosting Supabase cheaper than Supabase Cloud?', a: 'For one small app, no: Pro with Micro is $25 and a 4 GiB Droplet with backups is $28.80. It gets cheaper once you’d need Medium compute or more, go past 100,000 monthly active users, or push lots of egress, because self-hosted Supabase has no usage fees. In my 150,000-user example the cloud bill was about $228 and an 8 GiB server with backups $57.60.' },
  { q: 'What do you lose when you self-host Supabase?', a: 'Per Supabase’s self-hosting docs: multiple projects in one dashboard, branching, managed backups and point-in-time recovery, advanced metrics, analytics and vector buckets, ETL and the Management API. Support is community-only, and HTTPS, SMTP, updates and backups become your job.' },
  { q: 'Is Supabase cheaper than Firebase?', a: 'It depends on how your app reads data. Supabase charges a flat plan plus compute and doesn’t bill API requests. Firebase’s Blaze plan has no fee but bills Firestore per document read, write and delete past the daily free amounts (50,000 reads and 20,000 writes a day). A read-heavy app with lots of users is usually easier to predict on Supabase; a tiny app can stay at $0 on Firebase without the weekly pause.' },
  { q: 'Is Appwrite cheaper than Supabase?', a: 'Both Pro plans start at $25. Appwrite Pro includes 200,000 monthly active users and 2 TB of bandwidth against Supabase’s 100,000 users and 250 GB, so apps with many users or heavy downloads usually cost less there. Appwrite bills database reads and writes over its quota and charges $15 per extra project. I worked through three app sizes in the PocketBase vs Supabase vs Appwrite comparison.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'Supabase pricing: Free, Pro, Team, overages, and what self-hosting really costs', datePublished: '2026-10-25', dateModified: '2026-11-15', author: { '@type': 'Organization', name: 'SelfHost Office' }, mainEntityOfPage: new URL('/pricing/supabase/', Astro.site).toString() },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="Supabase pricing (Nov 2026): Free, Pro $25, Team $599, overages and self-hosted cost" description={`Supabase pricing read Nov 15, 2026: Free $0, Pro from $25 with one Micro project, Team $599, plus every overage rate. Worked bills at 150K and 300K users, and what self-hosting costs ($28.80 to $57.60 a month on DigitalOcean).`} schema={schema} crumbs={[['Home', '/'], ['Supabase pricing', '/pricing/supabase/']]}>
<div class="wrap page-head prose">
  <span class="eyebrow">Pricing guide · Checked on {CHECKED}</span>
  <h1>Supabase pricing: what Free, Pro and Team really cost, and when self-hosting is cheaper</h1>
  <p class="muted">Supabase’s pricing looks simple ($0, $25, $599) until you add projects, compute and usage. I re-read <a href={S.pricing}>its pricing page</a> on {CHECKED} (first written {FIRST}; no plan or compute price had changed), worked out three real monthly bills, and priced self-hosting from the <a href={S.docker}>Docker guide</a>, <a href={S.do}>DigitalOcean</a> and <a href={S.hz}>Hetzner</a> the same night. The download sizes are measured from Docker Hub, not guessed. I haven’t run a production Supabase on my own server, so the upkeep notes come from the docs plus my judgment. All prices are US dollars.</p>
  <p class="note"><b>Disclosure:</b> there are no affiliate links on this page. Supabase, Appwrite, Nhost, Google, DigitalOcean and Hetzner don’t pay us. <a href="/disclosure/">How we make money</a>.</p>

  <h2>The short version</h2>
  <ul>
    <li><b>Side project:</b> Free costs $0, but it pauses after a week with no activity and caps the database at 500 MB.</li>
    <li><b>One real app:</b> Pro is <b>$25/mo</b> with a 1 GB Micro instance. A second project (say, staging) makes it $35.</li>
    <li><b>Bigger instance:</b> Medium (4 GB) takes one project to <b>$75/mo</b> and Large (8 GB) to <b>$125/mo</b>.</li>
    <li><b>The bill that surprises people</b> is monthly active users: $0.00325 each past 100,000, so 150,000 users adds $162.50.</li>
    <li><b>Self-hosted:</b> $28.80 to $57.60 a month on DigitalOcean with backups, no usage fees, but one project per install and no managed backups.</li>
  </ul>
  <p>My take: for one app with normal traffic, pay for Pro. Self-hosting starts to make sense when you’d outgrow Small compute, have well over 100,000 monthly users or a lot of egress, or need the data on your own hardware.</p>
</div>

<section style="padding-top:6px"><div class="wrap">
<h2>Supabase plans and prices</h2>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col">Plan</th><th scope="col">Price</th><th scope="col">What’s included (from Supabase’s page)</th></tr></thead>
<tbody>{plans.map(p => <tr><th scope="row">{p.plan}</th><td><b class="usd">{p.price}</b></td><td>{p.note}</td></tr>)}</tbody>
</table></div>
<p class="note">Source: <a href={S.pricing}>supabase.com/pricing</a>, read {CHECKED}. Pro is charged monthly up front and usage over the included amounts at the end of the month. The plan price is per organization; compute is per project. Supabase adds sales tax or VAT where required.</p>

<h2>Compute: the part that grows with every project</h2>
<p>Every project runs on its own Postgres instance, billed hourly. Pro and Team include $10 a month of credit, which pays for one Micro. The credit doesn’t multiply: a second Micro project adds $10.</p>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col">Size</th><th scope="col">Compute price</th><th scope="col">CPU</th><th scope="col">RAM</th><th scope="col">Direct connections</th><th scope="col">One project on Pro, total</th></tr></thead>
<tbody>{compute.map(([n, p, c, r, conn]) => <tr><th scope="row">{n}</th><td>${p}/mo</td><td>{c}</td><td>{r}</td><td>{conn}</td><td><b class="usd">${25 + p - 10}/mo</b></td></tr>)}</tbody>
</table></div>
<p class="note">Total = $25 Pro + compute − $10 credit. Sizes go on to 4XL $960, 8XL $1,870, 12XL $2,800 and 16XL $3,730 a month. Source: <a href={S.pricing}>supabase.com/pricing</a>, {CHECKED}.</p>

<h2>Overage rates on Pro</h2>
<p>These only apply once you switch the spend cap off. With it on, Supabase holds you to the quota instead.</p>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col">What</th><th scope="col">Included on Pro</th><th scope="col">Then</th></tr></thead>
<tbody>{over.map(([w, i, t]) => <tr><th scope="row">{w}</th><td>{i}</td><td>{t}</td></tr>)}</tbody>
</table></div>
<p class="note">Team has the same allowances and rates. Source: the plan comparison on <a href={S.pricing}>supabase.com/pricing</a>, {CHECKED}.</p>

<h2>Three real monthly bills</h2>
<p>Numbers are what Supabase would charge with the spend cap off. I assumed all egress is uncached, which is the expensive case.</p>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col">App</th><th scope="col">Line items</th><th scope="col">Supabase Cloud</th></tr></thead>
<tbody>{ex.map(e => <tr><th scope="row">{e.name}<br/><span class="muted" style="font-weight:normal">{e.what}</span></th><td>{e.lines.map(([l, v]) => <>{l}: {(v as number) < 0 ? '−' + m(-(v as number)) : m(v as number)}<br/></>)}</td><td><b class="usd">{m(e.total)}/mo</b></td></tr>)}</tbody>
</table></div>
<p>The same three on a server you run: the first fits a 4 GiB Droplet ($28.80 with backups) if you put staging on the same box or on your laptop. The growing app fits the recommended 8 GiB size ($57.60 with backups), and its 500 GB of egress is well inside the 5,000 GiB of transfer the Droplet includes. For the busy app I’d budget the 16 GiB Droplet, $115.20 with backups, but I haven’t load-tested 300,000 users on one box, so treat that as a starting point. Point-in-time recovery isn’t an option self-hosted; you’d set up WAL archiving yourself.</p>
</div></section>

<section style="padding-top:0"><div class="wrap">
<h2>What self-hosting costs: the server</h2>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col">Server</th><th scope="col">Per month</th><th scope="col">With weekly backups (+20%)</th><th scope="col">Transfer included</th><th scope="col">Disk</th></tr></thead>
<tbody>{selfRows.map(r => <tr><th scope="row">{r.who}</th><td><b class="usd">{m(r.base)}</b>{r.eur && <> (€{r.eur})</>}</td><td>{m(r2(r.base * 1.2))}</td><td>{r.transfer}</td><td>{r.disk}</td></tr>)}</tbody>
</table></div>
<p class="note">Read {CHECKED} from <a href={S.do}>DigitalOcean Droplet pricing</a> (Basic, Regular CPU) and <a href={S.hz}>Hetzner Cost-Optimized</a>. Hetzner bills in euros before VAT; dollars here use the ECB reference rate of 1.1052 from Nov 13, 2026 (<a href={S.ecb} rel="nofollow">source</a>), so your card charge will differ a little. Both Hetzner plans showed “not available” tonight and are only sold in Germany and Finland; more on that in <a href="/compare/hetzner-vs-digitalocean-vs-vultr/">Hetzner vs DigitalOcean vs Vultr</a>.</p>

<h2>Cloud vs self-hosted, one project per month</h2>
<figure class="chart" style="margin:0">
<svg viewBox="0 0 640 300" width="100%" role="img" aria-labelledby="sbchart-t">
  <title id="sbchart-t">Monthly cost on {CHECKED}: Supabase Cloud Pro with Micro $25, Small $30, Medium $75, Large $125; self-hosted on DigitalOcean 4 GiB $28.80, 8 GiB $57.60 and Hetzner CX33 {m(r2(usd(8.99) * 1.2))}, all with backups</title>
  {bars.map((b, i) => {
    const y = 8 + i * 40; const w = (b.v / maxV) * 330;
    return <g>
      <text x="0" y={y + 14} font-size="12" fill="currentColor">{b.label}</text>
      <rect x="230" y={y + 2} width={w} height="16" fill={b.kind === 'cloud' ? '#2f3a4a' : '#c2410c'} />
      <text x={236 + w} y={y + 15} font-size="12" fill="currentColor">{m(b.v)}</text>
    </g>;
  })}
</svg>
<figcaption class="note">Dark: Supabase Cloud. Red: self-hosted. Prices from <a href={S.pricing}>Supabase</a>, <a href={S.do}>DigitalOcean</a> and <a href={S.hz}>Hetzner</a>, all read {CHECKED}. Your time isn’t in any bar.</figcaption>
</figure>
<p>These bars aren’t apples to apples, and it cuts both ways. A cloud Micro gives Postgres 1 GB of RAM to itself, with Auth, Storage and the rest running on Supabase’s side. A self-hosted 4 GiB box has to fit all eleven containers. On the other hand the server bill stays flat no matter how many users sign in.</p>
</div></section>

<section style="padding-top:0"><div class="wrap prose">
<h2>What self-hosting really takes</h2>
<p>Supabase’s <a href={S.docker}>Docker guide</a> asks for <b>4 GB RAM, 2 cores and 40 GB SSD</b> at minimum and <b>8 GB, 4 cores and 80 GB</b> as recommended. The current stable snapshot is <code>self-hosted/v0.8.4</code> (it was v0.8.3 when I first wrote this). You can drop Realtime, Storage, imgproxy or Edge Runtime from the compose file if you don’t use them, which is the easiest way to fit a 4 GB box.</p>
<p>I looked up every image pinned in the v0.8.4 <a href={S.compose}>compose file</a> on Docker Hub tonight (compressed, linux/amd64). The first pull is about <b>{(totalMB / 1000).toFixed(1)} GB</b>:</p>
</div>
<div class="wrap"><div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col">Container</th><th scope="col">Image tag</th><th scope="col">Download size</th></tr></thead>
<tbody>{images.map(([n, t, s]) => <tr><th scope="row">{n}</th><td>{t}</td><td>{s} MB</td></tr>)}</tbody>
<tfoot><tr><th scope="row">Total</th><td></td><td><b>{totalMB.toLocaleString('en-US')} MB</b></td></tr></tfoot>
</table></div>
<p class="note">Docker Hub API, read {CHECKED}. Logs and analytics (Logflare and Vector) are off by default and add more on top. For comparison, Appwrite’s main image (2.7.2, released Nov 12) is 190 MB, and PocketBase is a single 12.8 MB zip.</p></div>
<div class="wrap prose">
<h2>What you give up</h2>
<p>Straight from Supabase’s <a href={S.self}>self-hosting overview</a>:</p>
<ul>
  <li><b>One project per install.</b> Studio doesn’t do multiple projects or organizations. Staging and production means two stacks.</li>
  <li><b>No branching, no managed backups or point-in-time recovery,</b> no advanced metrics, no analytics or vector buckets, no ETL, and no Management API.</li>
  <li><b>Community support only.</b> Pro’s email support doesn’t apply.</li>
  <li><b>Jobs that become yours:</b> HTTPS (the guide suggests Caddy or Nginx in front), a real SMTP server for auth emails, OS and image updates, Postgres maintenance, backups, and keeping Studio off the open internet.</li>
</ul>
<p>The upside: self-hosted Supabase sends no telemetry, and the stack is Apache-2.0.</p>
</div></section>

<section style="padding-top:0"><div class="wrap">
<h2>Supabase vs Appwrite, Nhost, Firebase and PocketBase on price</h2>
<p class="muted">Entry prices and allowances only. For a three-size worked comparison with PocketBase memory measurements, see <a href="/compare/pocketbase-vs-supabase-vs-appwrite/">PocketBase vs Supabase vs Appwrite</a>.</p>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col">Backend</th><th scope="col">Free tier</th><th scope="col">Paid entry</th><th scope="col">Self-host</th><th scope="col">GitHub stars</th></tr></thead>
<tbody>{alts.map(a => <tr><th scope="row"><a href={a.href}>{a.who}</a></th><td>{a.free}</td><td>{a.paid}</td><td>{a.self}</td><td>{a.lic ? a.lic.stars.toLocaleString('en-US') : 'n/a'}</td></tr>)}</tbody>
</table></div>
<p class="note">Read {CHECKED}: <a href={S.aw}>Appwrite pricing</a> and <a href={S.awSelf}>self-hosting requirements</a>, <a href={S.nh}>Nhost pricing</a> and <a href={S.nhSelf}>self-hosting options</a>, <a href={S.fb}>Firebase pricing</a>, <a href={S.pb}>PocketBase</a> (release v0.40.6 still current). PocketBase memory is from my own test on Nov 1, 2026. Stars refresh nightly from GitHub.</p>
</div></section>

<section style="padding-top:0"><div class="wrap prose">
<h2>So which should you pick?</h2>
<ul>
  <li><b>Trying an idea:</b> Supabase Free, or Firebase Spark if you’d rather not have the weekly pause. Neither has backups.</li>
  <li><b>One production app, normal traffic:</b> Supabase Pro at $25. Self-hosting costs about the same and you lose managed backups and support.</li>
  <li><b>Lots of users, little data:</b> look at Appwrite Pro first. It’s the same $25 but includes twice the users and eight times the bandwidth.</li>
  <li><b>You’d need Medium compute or bigger, or well over 100,000 users:</b> self-host Supabase on an 8 GiB server ($57.60 with backups), if someone on the team is happy running Docker and testing restores.</li>
  <li><b>Small internal tool or MVP you’ll run yourself:</b> PocketBase on a $6 server. It isn’t Postgres and scales on one machine only, but it’s the least work of anything here.</li>
  <li><b>Data has to stay on your hardware:</b> self-host Supabase. That’s the case Supabase itself says it’s built for.</li>
</ul>
