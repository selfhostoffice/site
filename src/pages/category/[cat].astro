---
import Base from '../../layouts/Base.astro'; import Directory from '../../components/Directory.astro'; import Icon from '../../components/Icon.astro';
import { listings, cats, CATS, slugify } from '../../lib/data';
export function getStaticPaths() { return cats.map(cat => ({ params: { cat } })); }
const { cat } = Astro.params; const items = listings.filter(l => l.category === cat); const C = CATS[cat!];
const reps = [...new Set(items.map(l => l.replaces))];
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: `Open-source ${C.name} software`, itemListElement: items.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/tool/${l.slug}/`, Astro.site).toString(), name: l.name })) };
---
<Base title={`Best open-source ${C.name} software for small businesses`} description={`${items.length} self-hostable open-source ${C.name.toLowerCase()} tools compared by license, GitHub stars and recent activity.`} schema={schema} crumbs={[['Home', '/'], [C.name, `/category/${cat}/`]]}>
<div class="wrap page-head"><span class="eyebrow"><Icon name={C.icon} size={16}/> Category</span><h1>Open-source {C.name.toLowerCase()} software</h1><p class="muted">{C.blurb}. {items.length} self-hostable tools.</p>
<div class="quick">{reps.map(r => <a class="chip" href={`/alternatives/${slugify(r)}/`}>Compare alternatives to {r}</a>)}</div></div>
<section style="padding-top:18px"><div class="wrap"><Directory items={items} showCat={false}/></div></section>
</Base>
