---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import Icon from '../../components/Icon.astro'; import FeaturedSlot from '../../components/FeaturedSlot.astro';
import affiliates from '../../data/affiliates.json';
import { listings, catName, slugify, fmtDate, licLabel, licFamily, activity, activityLabel, avatar, kfmt, GUIDES } from '../../lib/data';
export function getStaticPaths() { return listings.map(l => ({ params: { slug: l.slug }, props: { l } })); }
const { l } = Astro.props;
const aff = (affiliates as Record<string, {href: string; label: string; terms: string}>)[l.slug];
const same = listings.filter(x => x.replaces === l.replaces && x.slug !== l.slug);
const related = listings.filter(x => x.category === l.category && x.slug !== l.slug && x.replaces !== l.replaces).slice(0, 6);
const schema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: l.name, description: l.description, applicationCategory: 'BusinessApplication', operatingSystem: 'Self-hosted', url: l.homepage || l.repoUrl, sameAs: [l.repoUrl], image: l.ownerAvatar, license: l.license === 'NOASSERTION' ? undefined : `https://spdx.org/licenses/${l.license}.html`, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
---
<Base title={`${l.name}: self-hosted, open-source alternative to ${l.replaces}`} description={`${l.name}: ${l.description}`.slice(0, 155)} schema={schema} crumbs={[['Home', '/'], [catName(l.category), `/category/${l.category}/`], [l.name, `/tool/${l.slug}/`]]}>
<div class="wrap page-head">
  <div class="tool-head"><img class="logo" src={avatar(l, 144)} alt={`${l.repo.split('/')[0]} avatar on GitHub`} width="72" height="72"/><div><h1 style="margin:0">{l.name}</h1><a class="chip" href={`/alternatives/${slugify(l.replaces)}/`}>Replaces {l.replaces}</a></div></div>
  <p class="lead muted" style="font-size:1.1rem;max-width:65ch">{l.description}</p>
  <div class="actions"><a class="btn" href={l.repoUrl} rel="nofollow" data-track="outbound" data-tool={l.slug} data-kind="repo"><Icon name="github" size={18}/>View on GitHub</a>{l.homepage && <a class="btn ghost" href={l.homepage} rel="nofollow" data-track="outbound" data-tool={l.slug} data-kind="website"><Icon name="globe" size={18}/>Website</a>}{aff && <a class="btn ghost" href={aff.href} rel="sponsored nofollow" data-track="outbound" data-tool={l.slug} data-kind="affiliate">{aff.label} (affiliate link)</a>}<a class="btn ghost" href={`/alternatives/${slugify(l.replaces)}/`}>Compare {l.replaces} alternatives</a><a class="btn ghost" href={`/claim/?tool=${l.slug}`}>Claim or get featured</a></div>
  {aff && <p class="note"><b>Affiliate disclosure:</b> the "{aff.label}" link is an affiliate link. If you sign up for a paid plan through it, we may earn {aff.terms}, at no extra cost to you. It does not change this listing's data. Self-hosting stays free. <a href="/disclosure/">How we make money</a>.</p>}
  <div class="facts">
    <div class="fact"><span>Stars</span><b>{l.stars.toLocaleString('en-US')}</b></div>
    <div class="fact"><span>License</span><b class={`lic-${licFamily(l.license)}`}>{licLabel(l.license)}</b></div>
    <div class="fact"><span>Last push</span><b>{fmtDate(l.lastPush)}</b><div><span class={`badge act-${activity(l)}`}>{activityLabel(l)}</span></div></div>
    <div class="fact"><span>Forks</span><b>{(l.forks ?? 0).toLocaleString('en-US')}</b></div>
    <div class="fact"><span>Open issues + PRs</span><b>{(l.openIssues ?? 0).toLocaleString('en-US')}</b></div>
    <div class="fact"><span>Language</span><b>{l.language ?? 'n/a'}</b></div>
  </div>
  <div style="margin-top:18px"><FeaturedSlot where={catName(l.category)} href={`/claim/?tool=${l.slug}`} title={`Maintain ${l.name}?`}/></div>
  {l.topics?.length > 0 && <div class="quick"><span>GitHub topics:</span>{l.topics.map((t: string) => <span class="badge">{t}</span>)}</div>}
  {GUIDES.filter(g => g.tools.includes(l.slug)).map(g => <p class="note"><b>Cost guide:</b> <a href={g.href}>{g.title}</a> (prices checked {g.checked})</p>)}
  <p class="note">Source: <a href={l.source}>{l.source}</a>, fetched {fmtDate(l.fetchedAt)}. "Active" means a push within 30 days of that fetch. Maintainer? <a href={`/claim/?tool=${l.slug}`}>Claim or get featured</a>.</p>
</div>
{same.length > 0 && <section><div class="wrap"><div class="sec-head"><h2>Other {l.replaces} alternatives</h2><a href={`/alternatives/${slugify(l.replaces)}/`}>Side-by-side comparison →</a></div><div class="grid">{same.map(x => <Card l={x}/>)}</div></div></section>}
{related.length > 0 && <section style="padding-top:0"><div class="wrap"><div class="sec-head"><h2>Related in {catName(l.category)}</h2></div><div class="grid">{related.map(x => <Card l={x}/>)}</div></div></section>}
</Base>
