---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import Icon from '../../components/Icon.astro'; import FeaturedSlot from '../../components/FeaturedSlot.astro'; import ZendeskGuide from '../../components/alt/ZendeskGuide.astro'; import GoogleAnalyticsGuide from '../../components/alt/GoogleAnalyticsGuide.astro'; import NetSuiteGuide from '../../components/alt/NetSuiteGuide.astro'; import ConfluenceGuide from '../../components/alt/ConfluenceGuide.astro'; import MicrosoftProjectGuide from '../../components/alt/MicrosoftProjectGuide.astro';
import { listings, products, slugify, catName, licLabel, licFamily, kfmt, fmtDate, activityLabel, activity, avatar, daysSincePush, GUIDES } from '../../lib/data';
export function getStaticPaths() { return products.map(p => ({ params: { p: slugify(p) }, props: { name: p } })); }
const { name } = Astro.props; const items = listings.filter(l => l.replaces === name); const guides = GUIDES.filter(g => items.some(l => g.tools.includes(l.slug)));
const cat = items[0].category; const related = listings.filter(l => l.category === cat && l.replaces !== name);
const PICKS: Record<string, { slug: string; kicker: string; reason: string }> = {
  Calendly: {
    slug: 'alextselegidis--easyappointments',
    kicker: 'Top pick for simple self-hosted appointment booking',
    reason: 'Easy!Appointments is a PHP and MySQL scheduler with staff calendars, provider and secretary roles, and a public booking page in the free release. Cal.diy is the closer Cal.com-style product and has far more stars, but its docs say it has no team features and is meant for personal use. If you want a small team taking bookings on your own server, and you can live without Cal.com’s routing and workflows, start with Easy!Appointments.',
  },
};
// Per-page copy matched to the query each page gets impressions for (GSC).
const OVR: Record<string, { title: string; description: string; h1: string; intro: string; extra?: string }> = {
  Zendesk: {
    title: 'Open-source Zendesk alternatives: 4 self-hosted helpdesks compared (2026)',
    description: 'Chatwoot, Zammad, Frappe Helpdesk and FreeScout compared as Zendesk replacements: hosted price for 5 agents, self-hosted server cost, license and Zendesk import, prices read Nov 18, 2026.',
    h1: 'Open-source Zendesk alternatives',
    intro: 'Four self-hostable helpdesks people move to from Zendesk, with what each costs hosted and on your own server. Which one fits depends on whether you use Zendesk for email tickets or for live chat and messaging',

    extra: 'FreeScout, which I file under Help Scout alternatives, is in the guide below.',
  },
  'Google Analytics': {
    title: 'Open-source Google Analytics alternatives: 4 self-hosted tools compared (2026)',
    description: 'Plausible, Umami, Matomo and PostHog as Google Analytics replacements: hosted price at 100K and 1M pageviews, self-hosted server cost, tracking script size I measured, prices read Nov 19, 2026.',
    h1: 'Open-source Google Analytics alternatives',
    intro: 'Four open-source analytics tools you can self-host instead of Google Analytics, with what each costs hosted and on your own server, and how big each tracking script is. Which one fits depends on whether you want simple traffic stats or GA-style goals and ecommerce reports',
    extra: 'PostHog, which I file under product analytics, is in the guide below.',
  },
  NetSuite: {
    title: 'Open-source NetSuite alternatives: ERPNext and Odoo cost for 10 users (2026)',
    description: 'ERPNext and Odoo as NetSuite replacements: hosted and self-hosted monthly cost for 10 users, server sizing, Docker image sizes I checked, prices read Nov 22, 2026.',
    h1: 'Open-source NetSuite alternatives',
    intro: 'The two open-source ERPs that can actually stand in for NetSuite, with what each costs for a 10-person company hosted and on your own server. NetSuite doesn’t publish prices, so the comparison is against your own quote',
  },
  Confluence: {
    title: 'Open-source Confluence alternatives: 4 self-hosted wikis compared (2026)',
    description: 'Docmost, Outline, BookStack and Wiki.js as Confluence replacements: monthly cost for 25 users hosted and self-hosted, Confluence import, Docker image sizes I checked, prices read Nov 23, 2026.',
    h1: 'Open-source Confluence alternatives',
    intro: 'Four self-hostable wikis teams move to from Confluence, with what each costs for 25 people hosted and on your own server, and which ones can import your Confluence spaces',
  },
  'Microsoft Project': {
    title: 'Open-source Microsoft Project alternatives: OpenProject, GanttProject, Redmine (2026)',
    description: 'OpenProject, GanttProject and Redmine as Microsoft Project replacements: cost for 10 users vs Planner Plan 1 and Project Plan 3, .mpp file support, server sizing, Docker image sizes I checked, prices read Nov 24, 2026.',
    h1: 'Open-source Microsoft Project alternatives',
    intro: 'Three free, open-source tools that can take over from Microsoft Project, a web app for teams, a desktop app that opens .mpp files and a lightweight tracker, with what each costs for 10 people next to Microsoft’s plans',
    extra: 'Plane and Leantime, which I file under Asana alternatives, are in the guide below.',
  },
};
const O = OVR[name];
const pick = PICKS[name];
const pickTool = pick && items.find(l => l.slug === pick.slug);
const maxStars = Math.max(...items.map(l => l.stars)); const minAge = Math.min(...items.map(daysSincePush));
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: `Open-source alternatives to ${name}`, itemListElement: items.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/tool/${l.slug}/`, Astro.site).toString(), name: l.name })) };
const fetched = fmtDate(items[0].fetchedAt);
---
<Base title={O?.title ?? `${items.length} open-source alternatives to ${name} (self-hosted, compared)`} description={O?.description ?? `Compare ${items.map(l => l.name).join(', ')}: self-hostable open-source alternatives to ${name}, side by side on license, stars and activity.`} schema={schema} crumbs={[['Home', '/'], ['Alternatives', '/#alternatives'], [name, `/alternatives/${slugify(name)}/`]]}>
<div class="wrap page-head"><span class="eyebrow">{catName(cat)}</span><h1>{O?.h1 ?? `Open-source alternatives to ${name}`}</h1>
{O && <p class="muted">{O.intro}.{O.extra && ' ' + O.extra}</p>}
<p class="muted">{items.length} self-hostable {items.length === 1 ? 'option' : 'options'} you can run on your own server, compared on facts from GitHub (fetched {fetched}).</p></div>
<section style="padding-top:14px"><div class="wrap">
{pick && pickTool && (
  <div class="pick">
    <p class="pick-kicker">{pick.kicker}</p>
    <p><a class="tool" href={`/tool/${pickTool.slug}/`}><img src={avatar(pickTool, 56)} alt="" width="28" height="28" loading="lazy"/>{pickTool.name}</a></p>
    <p class="muted">{pick.reason}</p>
  </div>
)}
<h2 class="sr-title">Side by side</h2>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col"><span class="muted small">Tool</span></th>{items.map(l => <th scope="col"><a class="tool" href={`/tool/${l.slug}/`}><img src={avatar(l, 56)} alt="" width="28" height="28" loading="lazy"/>{l.name}</a></th>)}</tr></thead>
<tbody>
<tr><th scope="row">GitHub stars</th>{items.map(l => <td class={l.stars === maxStars && items.length > 1 ? 'best' : ''}>{l.stars.toLocaleString('en-US')}</td>)}</tr>
<tr><th scope="row">License</th>{items.map(l => <td><span class={`badge lic-${licFamily(l.license)}`}>{licLabel(l.license)}</span></td>)}</tr>
<tr><th scope="row">Last push</th>{items.map(l => <td class={daysSincePush(l) === minAge && items.length > 1 ? 'best' : ''}>{fmtDate(l.lastPush)} <span class={`badge act-${activity(l)}`}>{activityLabel(l)}</span></td>)}</tr>
<tr><th scope="row">Forks</th>{items.map(l => <td>{(l.forks ?? 0).toLocaleString('en-US')}</td>)}</tr>
<tr><th scope="row">Open issues + PRs</th>{items.map(l => <td>{(l.openIssues ?? 0).toLocaleString('en-US')}</td>)}</tr>
<tr><th scope="row">Main language</th>{items.map(l => <td>{l.language ?? 'n/a'}</td>)}</tr>
<tr><th scope="row">Links</th>{items.map(l => <td><a href={l.repoUrl} rel="nofollow" data-track="outbound" data-tool={l.slug} data-kind="repo">Repo</a>{l.homepage && <> · <a href={l.homepage} rel="nofollow" data-track="outbound" data-tool={l.slug} data-kind="website">Website</a></>}</td>)}</tr>
</tbody></table></div>
<p class="note">Highlighted cells mark the highest star count and the most recent push. Source: GitHub REST API, per-tool links on each tool page. Copyleft licenses (AGPL/GPL) require sharing modifications if you distribute or (AGPL) serve them; check the repo license before deploying.</p>
<div style="margin-top:16px"><FeaturedSlot where={`the ${name} alternatives comparison`}/></div>
</div></section>
<section style="padding-top:0"><div class="wrap"><div class="sec-head"><h2>Each one, briefly</h2></div><div class="grid">{items.map(l => <Card l={l}/>)}</div></div></section>
{related.length > 0 && <section style="padding-top:0"><div class="wrap"><div class="sec-head"><h2>More in {catName(cat)}</h2></div><div class="grid">{related.map(l => <Card l={l}/>)}</div></div></section>}
{cat === 'email-marketing' && <div class="wrap"><p class="note"><b>Full guide:</b> <a href="/category/email-marketing/">Open-source email marketing software compared, with real monthly costs</a></p></div>}
{name === 'Zendesk' && <ZendeskGuide/>}
{name === 'Google Analytics' && <GoogleAnalyticsGuide/>}
{name === 'NetSuite' && <NetSuiteGuide/>}
{name === 'Confluence' && <ConfluenceGuide/>}
{name === 'Microsoft Project' && <MicrosoftProjectGuide/>}
{name === 'Asana' && <div class="wrap"><p class="note"><b>Need Gantt charts and dependencies?</b> <a href="/alternatives/microsoft-project/">Open-source Microsoft Project alternatives</a>: OpenProject, GanttProject and Redmine, with cost for 10 users.</p></div>}
{guides.length > 0 && <div class="wrap">{guides.map(g => <p class="note"><b>Cost guide:</b> <a href={g.href}>{g.title}</a> (prices checked {g.checked})</p>)}</div>}
</Base>
