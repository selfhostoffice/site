---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import Icon from '../../components/Icon.astro'; import FeaturedSlot from '../../components/FeaturedSlot.astro';
import { listings, products, slugify, catName, licLabel, licFamily, kfmt, fmtDate, activityLabel, activity, avatar, daysSincePush } from '../../lib/data';
export function getStaticPaths() { return products.map(p => ({ params: { p: slugify(p) }, props: { name: p } })); }
const { name } = Astro.props; const items = listings.filter(l => l.replaces === name);
const cat = items[0].category; const related = listings.filter(l => l.category === cat && l.replaces !== name);
const maxStars = Math.max(...items.map(l => l.stars)); const minAge = Math.min(...items.map(daysSincePush));
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: `Open-source alternatives to ${name}`, itemListElement: items.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/tool/${l.slug}/`, Astro.site).toString(), name: l.name })) };
const fetched = fmtDate(items[0].fetchedAt);
---
<Base title={`${items.length} open-source alternatives to ${name} (self-hosted, compared)`} description={`Compare ${items.map(l => l.name).join(', ')}: self-hostable open-source alternatives to ${name}, side by side on license, stars and activity.`} schema={schema} crumbs={[['Home', '/'], ['Alternatives', '/#alternatives'], [name, `/alternatives/${slugify(name)}/`]]}>
<div class="wrap page-head"><span class="eyebrow"><Icon name="arrow" size={16}/> {catName(cat)}</span><h1>Open-source alternatives to {name}</h1>
<p class="muted">{items.length} self-hostable {items.length === 1 ? 'option' : 'options'} you can run on your own server, compared on facts from GitHub (fetched {fetched}).</p></div>
<section style="padding-top:14px"><div class="wrap">
<h2 class="sr-title">Side-by-side comparison</h2>
<div class="compare-wrap"><table class="compare">
<thead><tr><th scope="col"><span class="muted small">Tool</span></th>{items.map(l => <th scope="col"><a class="tool" href={`/tool/${l.slug}/`}><img src={avatar(l, 56)} alt="" width="28" height="28" loading="lazy"/>{l.name}</a></th>)}</tr></thead>
<tbody>
<tr><th scope="row">GitHub stars</th>{items.map(l => <td class={l.stars === maxStars && items.length > 1 ? 'best' : ''}>{l.stars.toLocaleString('en-US')}</td>)}</tr>
<tr><th scope="row">License</th>{items.map(l => <td><span class={`badge lic-${licFamily(l.license)}`}>{licLabel(l.license)}</span></td>)}</tr>
<tr><th scope="row">Last push</th>{items.map(l => <td class={daysSincePush(l) === minAge && items.length > 1 ? 'best' : ''}>{fmtDate(l.lastPush)} <span class={`badge act-${activity(l)}`}>{activityLabel(l)}</span></td>)}</tr>
<tr><th scope="row">Forks</th>{items.map(l => <td>{(l.forks ?? 0).toLocaleString('en-US')}</td>)}</tr>
<tr><th scope="row">Open issues + PRs</th>{items.map(l => <td>{(l.openIssues ?? 0).toLocaleString('en-US')}</td>)}</tr>
<tr><th scope="row">Main language</th>{items.map(l => <td>{l.language ?? 'n/a'}</td>)}</tr>
<tr><th scope="row">Links</th>{items.map(l => <td><a href={l.repoUrl} rel="nofollow">Repo</a>{l.homepage && <> · <a href={l.homepage} rel="nofollow">Website</a></>}</td>)}</tr>
</tbody></table></div>
<p class="note">Highlighted cells mark the highest star count and the most recent push. Source: GitHub REST API, per-tool links on each tool page. Copyleft licenses (AGPL/GPL) require sharing modifications if you distribute or (AGPL) serve them; check the repo license before deploying.</p>
<div style="margin-top:16px"><FeaturedSlot where={`the ${name} alternatives comparison`}/></div>
</div></section>
<section style="padding-top:0"><div class="wrap"><div class="sec-head"><h2>The options</h2></div><div class="grid">{items.map(l => <Card l={l}/>)}</div></div></section>
{related.length > 0 && <section style="padding-top:0"><div class="wrap"><div class="sec-head"><h2>More in {catName(cat)}</h2></div><div class="grid">{related.map(l => <Card l={l}/>)}</div></div></section>}
</Base>
