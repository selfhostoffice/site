---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import { SITE_NAME } from '../lib/data';
const { title, description, schema, crumbs } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const bc = crumbs && { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map(([n, u]: [string, string], i: number) => ({ '@type': 'ListItem', position: i + 1, name: n, item: new URL(u, Astro.site).toString() })) };
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} | {SITE_NAME}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
<meta name="twitter:card" content="summary"/><meta name="color-scheme" content="light dark"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preconnect" href="https://avatars.githubusercontent.com"/>
<script is:inline>(()=>{const t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t})()</script>
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
{bc && <script type="application/ld+json" set:html={JSON.stringify(bc)} />}
</head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="wrap nav">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">S</span><span>SelfHost<b>Office</b></span></a>
  <form class="nav-search" action="/" role="search"><Icon name="search" size={16}/><input name="q" type="search" placeholder="Search tools, e.g. DocuSign" aria-label="Search tools"/></form>
  <nav class="nav-links" aria-label="Main"><a href="/#categories">Categories</a><a href="/#alternatives">Alternatives</a><a href="/featured/">Get featured</a>
  <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle><span class="i-sun"><Icon name="sun" size={18}/></span><span class="i-moon"><Icon name="moon" size={18}/></span></button></nav>
</div></header>
{crumbs && <nav class="wrap crumbs" aria-label="Breadcrumb">{crumbs.map(([n, u]: [string, string], i: number) => i < crumbs.length - 1 ? <><a href={u}>{n}</a><span aria-hidden="true">/</span></> : <span aria-current="page">{n}</span>)}</nav>}
<main id="main"><slot/></main>
<footer class="site-footer"><div class="wrap foot">
  <div><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">S</span><span>SelfHost<b>Office</b></span></a><p class="muted small">Open-source back-office software a small business can run on its own server. Every fact links to its source on GitHub.</p></div>
  <div class="foot-links"><a href="/featured/">Claim or feature a listing</a><a href="/disclosure/">Affiliate & sponsor disclosure</a><a href="https://github.com/selfhostoffice/site">Source & data on GitHub</a></div>
</div></footer>
<script is:inline>document.querySelector('[data-theme-toggle]').addEventListener('click',()=>{const d=document.documentElement,cur=d.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'),n=cur==='dark'?'light':'dark';d.dataset.theme=n;localStorage.setItem('theme',n)})</script>
</body></html>
