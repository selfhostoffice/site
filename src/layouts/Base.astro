---
import { SITE_NAME, cats, CATS } from '../lib/data';
const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} | {SITE_NAME}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/>
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
<style is:global>body{font:16px/1.5 system-ui,sans-serif;max-width:960px;margin:auto;padding:1rem;color:#1a1a1a}a{color:#0b5bd3}header,footer{display:flex;gap:1rem;flex-wrap:wrap;align-items:center}header{border-bottom:1px solid #ddd;padding-bottom:.5rem}footer{border-top:1px solid #ddd;margin-top:2rem;padding-top:.5rem;font-size:.9rem}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem}.card{border:1px solid #ddd;border-radius:8px;padding:1rem}.muted{color:#666;font-size:.9rem}table{border-collapse:collapse;width:100%}td,th{border-bottom:1px solid #eee;padding:.4rem;text-align:left}</style>
</head><body><header><a href="/"><strong>{SITE_NAME}</strong></a><nav>{cats.slice(0,6).map(c=> <a href={`/category/${c}/`} style="margin-right:.6rem">{CATS[c]}</a>)}</nav><a href="/featured/">Get featured</a></header>
<main><slot/></main>
<footer><span>Data from the public GitHub API; each listing links its source.</span><a href="/disclosure/">Affiliate & sponsor disclosure</a><a href="/featured/">Claim or feature a listing</a></footer></body></html>
